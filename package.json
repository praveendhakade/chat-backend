    "@typescript/native": "npm:typescript@7.0.2",
    "jest": "30.5.2",
    "prisma": "7.10.1",
    "supertest": "7.3.2",
    "ts-jest": "29.4.15",
    "tsx": "4.23.15",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "allowScripts": {
    "@firebase/util@1.15.3": true,
